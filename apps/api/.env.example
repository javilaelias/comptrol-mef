DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comptrol?schema=public"
JWT_SECRET="change-me-in-prod"

# Secreto dedicado para verificar el ticket SSO firmado por gti-app (portal OPDA Apps).
# NO reusar JWT_SECRET: este secreto es propio de Comptrol-MEF y distinto al que
# gti-app usa para las otras apps del launcher (APP_LAUNCH_SECRET, compartido).
GTI_SSO_SECRET="change-me-in-prod"

# Security / hardening
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
THROTTLE_ENABLED="true"
THROTTLE_TTL_SEC="60"
THROTTLE_LIMIT="300"

# Logging
REQUEST_LOG_ENABLED="true"

# Agent (si usas el agente Windows)
AGENT_API_KEY="change-me"
