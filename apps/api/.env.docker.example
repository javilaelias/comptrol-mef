DATABASE_URL="postgresql://postgres:postgres@db:5432/comptrol?schema=public"
JWT_SECRET="change-me-in-prod"

# Security / hardening
# Para dev: el navegador pega a http://localhost:3001
CORS_ORIGINS="http://localhost:3000"
THROTTLE_ENABLED="true"
THROTTLE_TTL_SEC="60"
THROTTLE_LIMIT="300"

# Logging
REQUEST_LOG_ENABLED="true"

# Agent (si usas el agente Windows)
AGENT_API_KEY="change-me"
